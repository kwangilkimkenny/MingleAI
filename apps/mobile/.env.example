# IMPORTANT: production builds MUST set this to an https:// URL (cleartext HTTP is blocked on iOS/Android release builds).
# Use your machine's LAN IP when testing on a physical device, e.g. http://192.168.0.10:3000
# Use http://localhost:3000 for the iOS simulator; http://10.0.2.2:3000 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:3000

# 소셜 로그인 Client ID (설정한 provider만 로그인 화면에 노출). preview/production은 최소 하나가 필수.
EXPO_PUBLIC_NAVER_CLIENT_ID=
# EXPO_PUBLIC_KAKAO_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
