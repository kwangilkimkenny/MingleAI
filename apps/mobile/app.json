{
  "expo": {
    "name": "mingleai",
    "slug": "mingles",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mingleai",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mingleai.app",
      "requireFullScreen": true,
      "infoPlist": {
        "NSCameraUsageDescription": "블라인드 데이트 마지막 단계의 얼굴 공개 영상 통화를 위해 카메라 접근이 필요해요.",
        "NSMicrophoneUsageDescription": "블라인드 데이트 음성 대화를 위해 마이크 접근이 필요해요."
      }
    },
    "android": {
      "package": "com.mingleai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A120C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A120C"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진으로 쓸 사진을 선택할 수 있도록 사진 접근 권한이 필요해요."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 상대와 매칭하고 주변 맛집을 추천하기 위해 위치 접근이 필요해요.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "블라인드 데이트 마지막 단계의 얼굴 공개 영상 통화를 위해 카메라 접근이 필요해요.",
          "microphonePermission": "블라인드 데이트 음성 대화를 위해 마이크 접근이 필요해요."
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://repository.map.naver.com/archive/maven"]
          }
        }
      ],
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": ""
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "40685544-2478-4e54-8090-7cfbd66baaee"
      }
    }
  }
}
