# mingles 운영 backend 환경변수 템플릿 — 코드에서 실제로 읽는 값만.
# 실제 .env.production은 커밋하지 말 것(비밀값 포함). 플랫폼(Railway/Render/Fly)의
# 시크릿 매니저에 넣는 것을 권장.

# ── 필수 ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000                                   # 플랫폼이 주입하면 그 값이 우선
# Postgres. 운영 매니지드 DB의 DSN. sslmode 필요할 수 있음.
DATABASE_URL=postgresql://user:pass@host:5432/mingle?schema=public
# JWT 서명 비밀 — 길고 랜덤하게(예: openssl rand -base64 48). 유출 시 전 세션 위조 가능.
JWT_SECRET=
# 앱이 접근하는 공개 HTTPS 도메인. 업로드 URL·소셜 redirect의 호스트 기준.
PUBLIC_BASE_URL=https://api.example.com
# 소켓·REST CORS 허용 출처(콤마 구분). 미설정 시 dev는 모든 출처 반사, production은 부팅 경고.
SOCKET_CORS_ORIGINS=https://app.example.com

# ── 강력 권장 ────────────────────────────────────────
# Redis. 미설정 시 인메모리로 폴백하지만 재시작 시 상태 유실 + 다중 인스턴스 불가.
REDIS_URL=redis://host:6379

# ── 소셜 로그인(최소 1개 — mobile release:validate가 강제) ──
# 콘솔에서 발급, redirect URI를 PUBLIC_BASE_URL/auth/callback/<provider>로.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 본인인증(운영 필수) ──────────────────────────────
# 실 본인확인 사업자 연동 키. IDENTITY_DEV_BYPASS는 production에서 사용 금지(부팅 차단 대상).
# IDENTITY_DEV_BYPASS=  ← production에 넣지 말 것

# ── LiveKit(스피드데이트 미디어) ─────────────────────
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AI(선호 분석·답변 추천) ──────────────────────────
# 미설정 시 규칙 기반 폴백으로 강등(앱은 동작). 설정하면 실 LLM.
LLM_API_URL=https://api.openai.com
LLM_CHAT_PATH=/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=none                   # 추론형 모델이면 temperature 대신 이 값 전송
LLM_TIMEOUT_MS=15000

# ── 네이버 지역검색(맛집) ────────────────────────────
# 미설정 시 맛집 탭이 "준비 중" 빈 상태.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ── 관리자 콘솔(웹) ──────────────────────────────────
# 미설정 시 admin-login 501. ADMIN_PASSWORD_HASH는 bcrypt 해시.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ── 선택: 튜닝(기본값 있음) ──────────────────────────
# REFRESH_TOKEN_DAYS=30
# MESSAGE_MAX_LEN=2000
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=120
# 스피드데이트 타이밍(SPEEDDATE_*)은 speed-date.config.ts 기본값 사용. 운영은 손대지 말 것.
# ⚠️ SPEEDDATE_AI_FILL은 production에서 강제 off(코드가 무시) — AI 참가자를 실유저와 안 섞음.
