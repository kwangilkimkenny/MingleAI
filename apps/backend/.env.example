# mingles backend 환경변수 예시 — 복사해서 .env 로 사용.
# (기본값)이 표시된 항목은 생략 가능. prod 필수 항목은 [PROD] 표기.

# ── Core ─────────────────────────────────────────────────────────────────────
# [PROD] Postgres DSN (로컬: docker compose up -d, 포트 5433)
DATABASE_URL=postgresql://mingle:mingle_dev@localhost:5433/mingle
# [PROD] JWT 서명 키 — prod는 충분히 긴 랜덤 문자열로 교체
JWT_SECRET=change-me
# 선택: 없으면 인메모리 폴백
REDIS_URL=redis://localhost:6379
PORT=3000
# [PROD] 업로드 파일 절대 URL 호스트 (예: https://api.mingles.com)
# PUBLIC_BASE_URL=

# ── CORS / Rate limit ────────────────────────────────────────────────────────
# [PROD] 허용 HTTPS origin 콤마 목록. 미설정/HTTP/와일드카드는 prod 부팅 실패
# SOCKET_CORS_ORIGINS=https://app.mingles.com,https://admin.mingles.com
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=120

# ── 소셜 로그인 (developers 콘솔에서 발급, code→token 교환용) ────────────────
# [PROD] 최소 1개 provider 필수. 미설정 provider는 501 응답
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── 개발용 우회 (prod 강제 off — 절대 prod에 켜지 마라) ──────────────────────
DEV_AUTH_ENABLED=true
IDENTITY_DEV_BYPASS=true

# ── 관리자 (웹 관리자 로그인) ────────────────────────────────────────────────
# 해시 생성: node -e "console.log(require('bcrypt').hashSync(process.argv[1],10))" '비밀번호'
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=

# ── AI 선호 분석 (미설정 시 stub 분석기) ─────────────────────────────────────
# LLM_API_URL=
# LLM_CHAT_PATH=/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_MS=20000

# ── 파티 매칭 (기본값) ───────────────────────────────────────────────────────
# MIN_PARTY_SIZE=4
# MAX_PARTY_SIZE=8
# MATCH_SWEEP_MS=2500
# MATCH_MAX_WAIT_MS=120000
# MATCH_BASE_THRESHOLD=0.5

# ── 어몽(AI를 찾아라 — 현재 FEATURES.partyGame=false로 비활성) ───────────────
# AMONG_MIN_PLAYERS=4 / AMONG_TASKS_PER_CREW=3 / AMONG_KILL_RANGE=0.12 …
# 전체 목록·기본값: src/party/among.config.ts

# ── 프로포즈/메신저 ─────────────────────────────────────────────────────────
# PROPOSAL_WINDOW_HOURS=24
# PROPOSAL_MAX_PER_PARTY=3
# MESSAGE_MAX_LEN=2000

# ── 블라인드 스피드 데이트 ───────────────────────────────────────────────────
# SPEEDDATE_STAGES=3            # 1=FACE만, 2=VOICE+FACE, 3=풀(기본)
# SPEEDDATE_GROUP_PER_GENDER=3  # 1이면 1:1 모드(QA/저트래픽)
# SPEEDDATE_PREFLIGHT_MS=20000
# SPEEDDATE_STAGE_INTRO_MS=5000
# SPEEDDATE_ROUND_MS=300000     # 라운드당 5분
# SPEEDDATE_INTERMISSION_MS=5000
# SPEEDDATE_DECISION_MS=10000
# SPEEDDATE_SWEEP_MS=2500
# SPEEDDATE_MAX_WAIT_MS=120000
# SPEEDDATE_BASE_THRESHOLD=0.4
# SPEEDDATE_AI_FILL=false       # dev 전용: 빈 슬롯 AI 채움(솔로 테스트)

# ── LiveKit (음성/영상 — 로컬: docker compose up -d livekit) ─────────────────
# [PROD] LiveKit Cloud 또는 자체 서버 값으로 교체
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── 네이버 (로그인과 같은 앱이면 동일 값) ────────────────────────────────────
# 지역검색(맛집): 둘 다 있어야 GET /places/nearby 실데이터
# NAVER_SEARCH_CLIENT_ID=
# NAVER_SEARCH_CLIENT_SECRET=

# ── Push (EAS) ───────────────────────────────────────────────────────────────
# 선택: Expo push 보안 강화 토큰
# EXPO_ACCESS_TOKEN=
