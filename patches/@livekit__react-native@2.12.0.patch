+++ b/android/src/main/java/com/livekit/reactnative/audio/processing/VoiceDisguiseProcessor.kt
@@ -0,0 +1,85 @@
+package com.livekit.reactnative.audio.processing
+
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.floor
+
+/**
+ * Lightweight publisher-side granular pitch shifter. WebRTC gives this processor 10 ms planar
+ * float PCM frames; two cross-faded circular-buffer taps change pitch without changing packet
+ * duration. The short warm-up is intentionally silent so raw speech is never exposed while the
+ * disguise buffer is being primed.
+ */
+class VoiceDisguiseProcessor : AudioProcessorInterface {
+    @Volatile
+    var enabled: Boolean = false
+        set(value) {
+            if (value && !field) resetState()
+            field = value
+        }
+
+    private var ring = FloatArray(8192)
+    private var writePosition = 0
+    private var readPosition = 0.0
+    private var filled = 0
+    private var sampleRate = 48_000
+    private val pitchRatio = 0.72
+
+    override fun isEnabled(): Boolean = enabled
+
+    override fun getName(): String = "mingles-voice-disguise"
+
+    override fun initializeAudioProcessing(sampleRateHz: Int, numChannels: Int) {
+        sampleRate = sampleRateHz
+        val required = (sampleRateHz * numChannels.coerceAtLeast(1) / 6).coerceAtLeast(2048)
+        var capacity = 1
+        while (capacity < required) capacity = capacity shl 1
+        ring = FloatArray(capacity)
+        resetState()
+    }
+
+    override fun resetAudioProcessing(newRate: Int) {
+        initializeAudioProcessing(newRate, 1)
+    }
+
+    override fun processAudio(numBands: Int, numFrames: Int, buffer: ByteBuffer) {
+        if (!enabled) return
+        val floatBuffer = buffer.order(ByteOrder.nativeOrder()).asFloatBuffer()
+        val sampleCount = minOf(floatBuffer.remaining(), numBands.coerceAtLeast(1) * numFrames)
+        val grain = ring.size / 2
+
+        for (index in 0 until sampleCount) {
+            val input = floatBuffer.get(index)
+            ring[writePosition] = input
+            writePosition = (writePosition + 1) % ring.size
+            if (filled < grain) filled++
+
+            if (filled < grain) {
+                floatBuffer.put(index, 0f)
+                continue
+            }
+
+            val first = interpolate(readPosition)
+            val secondPosition = (readPosition + grain) % ring.size
+            val second = interpolate(secondPosition)
+            val phase = ((readPosition % grain) / grain).toFloat()
+            floatBuffer.put(index, (first * phase + second * (1f - phase)).coerceIn(-1f, 1f))
+            readPosition += pitchRatio
+            if (readPosition >= ring.size) readPosition -= ring.size
+        }
+    }
+
+    private fun interpolate(position: Double): Float {
+        val base = floor(position).toInt() % ring.size
+        val next = (base + 1) % ring.size
+        val fraction = (position - floor(position)).toFloat()
+        return ring[base] * (1f - fraction) + ring[next] * fraction
+    }
+
+    private fun resetState() {
+        ring.fill(0f)
+        writePosition = 0
+        readPosition = 0.0
+        filled = 0
+    }
+}
