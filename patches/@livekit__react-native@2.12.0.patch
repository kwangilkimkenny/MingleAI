@@ -0,0 +1,9 @@
+#import <Foundation/Foundation.h>
+#import "LKAudioProcessingAdapter.h"
+
+/** Publisher-side PCM pitch shifter used during the disguised-voice stage. */
+@interface LKVoiceDisguiseProcessor : NSObject <LKExternalAudioProcessingDelegate>
+
+@property(atomic, assign, getter=isEnabled) BOOL enabled;
+
+@end
diff --git a/ios/LKVoiceDisguiseProcessor.m b/ios/LKVoiceDisguiseProcessor.m
new file mode 100644
index 0000000000000000000000000000000000000000..9815a79209c0ff05a1d726cb35eb34ea31d940f2
--- /dev/null
+++ b/ios/LKVoiceDisguiseProcessor.m
@@ -0,0 +1,152 @@
+#import "LKVoiceDisguiseProcessor.h"
+#import <math.h>
+#import <os/lock.h>
+
+static const double LKVoiceDisguisePitchRatio = 0.72;
+
+@implementation LKVoiceDisguiseProcessor {
+  os_unfair_lock _lock;
+  float** _rings;
+  size_t* _writePositions;
+  double* _readPositions;
+  size_t* _filled;
+  size_t _ringSize;
+  size_t _channels;
+}
+
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    _lock = OS_UNFAIR_LOCK_INIT;
+    _rings = NULL;
+    _writePositions = NULL;
+    _readPositions = NULL;
+    _filled = NULL;
+    _ringSize = 0;
+    _channels = 0;
+    _enabled = NO;
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self releaseState];
+}
+
+- (void)setEnabled:(BOOL)enabled {
+  os_unfair_lock_lock(&_lock);
+  if (enabled && !_enabled) {
+    [self resetStateLocked];
+  }
+  _enabled = enabled;
+  os_unfair_lock_unlock(&_lock);
+}
+
+- (void)audioProcessingInitializeWithSampleRate:(size_t)sampleRateHz channels:(size_t)channels {
+  os_unfair_lock_lock(&_lock);
+  [self releaseStateLocked];
+
+  size_t required = MAX((sampleRateHz * MAX(channels, 1)) / 6, 2048);
+  _ringSize = 1;
+  while (_ringSize < required) {
+    _ringSize <<= 1;
+  }
+  _channels = MAX(channels, 1);
+  _rings = calloc(_channels, sizeof(float*));
+  _writePositions = calloc(_channels, sizeof(size_t));
+  _readPositions = calloc(_channels, sizeof(double));
+  _filled = calloc(_channels, sizeof(size_t));
+  for (size_t channel = 0; channel < _channels; channel++) {
+    _rings[channel] = calloc(_ringSize, sizeof(float));
+  }
+  os_unfair_lock_unlock(&_lock);
+}
+
+- (void)audioProcessingProcess:(RTC_OBJC_TYPE(RTCAudioBuffer) *)audioBuffer {
+  os_unfair_lock_lock(&_lock);
+  if (!_enabled || !_rings || _ringSize == 0) {
+    os_unfair_lock_unlock(&_lock);
+    return;
+  }
+
+  const size_t channelCount = MIN((size_t)audioBuffer.channels, _channels);
+  const size_t frameCount = (size_t)audioBuffer.frames;
+  const size_t grain = _ringSize / 2;
+
+  for (size_t channel = 0; channel < channelCount; channel++) {
+    float* samples = [audioBuffer rawBufferForChannel:(int)channel];
+    float* ring = _rings[channel];
+    for (size_t frame = 0; frame < frameCount; frame++) {
+      ring[_writePositions[channel]] = samples[frame];
+      _writePositions[channel] = (_writePositions[channel] + 1) % _ringSize;
+      if (_filled[channel] < grain) {
+        _filled[channel]++;
+      }
+
+      if (_filled[channel] < grain) {
+        samples[frame] = 0.0f;
+        continue;
+      }
+
+      double firstPosition = _readPositions[channel];
+      double secondPosition = fmod(firstPosition + (double)grain, (double)_ringSize);
+      float first = [self interpolate:ring position:firstPosition];
+      float second = [self interpolate:ring position:secondPosition];
+      float phase = (float)(fmod(firstPosition, (double)grain) / (double)grain);
+      samples[frame] = fmaxf(-32768.0f, fminf(32767.0f, first * phase + second * (1.0f - phase)));
+
+      _readPositions[channel] += LKVoiceDisguisePitchRatio;
+      if (_readPositions[channel] >= (double)_ringSize) {
+        _readPositions[channel] -= (double)_ringSize;
+      }
+    }
+  }
+  os_unfair_lock_unlock(&_lock);
+}
+
+- (void)audioProcessingRelease {
+  [self releaseState];
+}
+
+- (float)interpolate:(float*)ring position:(double)position {
+  size_t base = ((size_t)floor(position)) % _ringSize;
+  size_t next = (base + 1) % _ringSize;
+  float fraction = (float)(position - floor(position));
+  return ring[base] * (1.0f - fraction) + ring[next] * fraction;
+}
+
+- (void)resetStateLocked {
+  if (!_rings) return;
+  for (size_t channel = 0; channel < _channels; channel++) {
+    memset(_rings[channel], 0, _ringSize * sizeof(float));
+    _writePositions[channel] = 0;
+    _readPositions[channel] = 0.0;
+    _filled[channel] = 0;
+  }
+}
+
+- (void)releaseState {
+  os_unfair_lock_lock(&_lock);
+  [self releaseStateLocked];
+  os_unfair_lock_unlock(&_lock);
+}
+
+- (void)releaseStateLocked {
+  if (_rings) {
+    for (size_t channel = 0; channel < _channels; channel++) {
+      free(_rings[channel]);
+    }
+  }
+  free(_rings);
+  free(_writePositions);
+  free(_readPositions);
+  free(_filled);
+  _rings = NULL;
+  _writePositions = NULL;
+  _readPositions = NULL;
+  _filled = NULL;
+  _ringSize = 0;
+  _channels = 0;
+}
+
+@end
