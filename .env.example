# Database
DATABASE_URL="postgresql://mingle:mingle_dev@localhost:5433/mingle?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"

# Redis (optional - uses in-memory cache if not set)
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000

# AI preference analysis (self-served, OpenAI-compatible chat completions).
# Leave LLM_API_URL empty to use the deterministic StubPreferenceAnalyzer (dev/CI, no external calls).
LLM_API_URL=
LLM_CHAT_PATH=/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
