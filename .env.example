# Database
DATABASE_URL="postgresql://mingle:mingle_dev@localhost:5433/mingle?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"

# Redis (optional - uses in-memory cache if not set)
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000

# AI preference analysis (self-served, OpenAI-compatible chat completions).
# Leave LLM_API_URL empty to use the deterministic StubPreferenceAnalyzer (dev/CI, no external calls).
LLM_API_URL=
LLM_CHAT_PATH=/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000

# Matchmaking queue (Phase 3)
MIN_PARTY_SIZE=4
MAX_PARTY_SIZE=8
MATCH_SWEEP_MS=2500
MATCH_MAX_WAIT_MS=120000
MATCH_BASE_THRESHOLD=0.5

# Global rate limiting (@nestjs/throttler; validated defaults, see src/common/throttle.config.ts)
# RATE_LIMIT_TTL_MS=60000 (default, floor 1000)
# RATE_LIMIT_MAX=120 (default, floor 5)

# Blind Speed Date (validated defaults, see src/speed-date/speed-date.config.ts)
# SPEEDDATE_STAGES: 1 = FACE only (vertical slice), 2 = VOICE+FACE, 3 = DISGUISED+VOICE+FACE (full)
SPEEDDATE_STAGES=1
SPEEDDATE_GROUP_PER_GENDER=3
SPEEDDATE_PREFLIGHT_MS=20000
SPEEDDATE_ROUND_MS=180000
SPEEDDATE_INTERMISSION_MS=10000
SPEEDDATE_DECISION_MS=10000
SPEEDDATE_SWEEP_MS=2500
SPEEDDATE_MAX_WAIT_MS=120000
SPEEDDATE_BASE_THRESHOLD=0.4
# dev-only: fill missing 3+3 slots with AI so a single tester can form a session (never in prod)
SPEEDDATE_AI_FILL=false

# ── Auth: social-only (email/password removed) ──────────────────────────────
# Social OAuth (backend exchanges the code with the SECRET; empty = provider disabled → 501).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mobile needs the PUBLIC client ids too (apps/mobile/.env): EXPO_PUBLIC_KAKAO_CLIENT_ID, etc.
#
# Dev/CI/admin login bypass — POST /auth/dev-login. MUST be false/unset in production
# (env.validation throws if "true" in production). Enables the mobile __DEV__ dev-login button.
DEV_AUTH_ENABLED=true
# Real-name identity (본인인증) dev bypass — accepts a test identity instead of a real 인증기관.
# MUST be false/unset in production (env.validation throws if "true" in production).
IDENTITY_DEV_BYPASS=true

# LiveKit media (blind speed date video/voice). Empty = no media (avatar-only; logic still runs).
# Local dev: `docker compose up -d livekit` (runs `livekit-server --dev`), then set:
#   LIVEKIT_URL=ws://localhost:7880  LIVEKIT_API_KEY=devkey  LIVEKIT_API_SECRET=secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
