{
  "name": "mingle-ai",
  "version": "0.1.0",
  "private": true,
  "description": "MingleAI monorepo - Another I dating platform",
  "scripts": {
    "dev:mcp": "pnpm --filter @mingle/mcp dev",
    "dev:mingleai-mcp": "pnpm --filter @mingle/mingleai-mcp dev",
    "dev:backend": "pnpm --filter @mingle/backend start:dev",
    "dev:web": "pnpm --filter @mingle/web dev",
    "dev:mobile": "pnpm --filter @mingle/mobile exec expo start",
    "seed:mobile-qa": "node tools/seed-mobile-qa.mjs",
    "qa:speed-date-bots": "node tools/speed-date-qa-bots.mjs",
    "release:check": "pnpm --filter @mingle/backend prisma:generate && pnpm audit --prod --audit-level high && pnpm lint && pnpm test && pnpm build && pnpm --filter @mingle/mobile release:validate",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.6 <8.0.0",
      "@modelcontextprotocol/sdk>@hono/node-server": ">=2.0.5",
      "body-parser": ">=2.3.0",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "engine.io": ">=6.6.7",
      "form-data": ">=4.0.6",
      "js-yaml": ">=5.2.2 <6.0.0",
      "picomatch": ">=2.3.2",
      "tinyglobby>picomatch": ">=4.0.4",
      "postcss": ">=8.5.23 <9.0.0",
      "qs": ">=6.14.2",
      "sharp": ">=0.35.0",
      "socket.io-parser": ">=4.2.6",
      "ws": ">=8.20.1",
      "minimatch@3.1.2>brace-expansion": "1.1.12",
      "minimatch@3.1.5>brace-expansion": "1.1.12",
      "minimatch@9.0.5>brace-expansion": "2.0.2",
      "minimatch@10.2.5>brace-expansion": "5.0.9",
      "expo-server-sdk>undici": ">=7.29.0 <8.0.0",
      "xcode>uuid": ">=11.1.1",
      "yaml": ">=1.10.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "bcrypt",
      "esbuild",
      "prisma",
      "@prisma/engines"
    ]
  }
}
